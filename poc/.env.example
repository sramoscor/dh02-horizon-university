# Copie a .env (make up lo hace si no existe). Valores de EJEMPLO para la demo: no son credenciales reales.
POSTGRES_PASSWORD=dh02-demo-only
XID_SIGNING_SECRET=demo-only-not-a-real-secret
DEMO_MODE=true

# Parámetros del worker (QS-02, §9.5). Por defecto = valores del diseño.
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=15
WORKER_BACKOFF_SECONDS=5,10,20,30
WORKER_MAX_ATTEMPTS=12
NOTIFY_TIMEOUT_SECONDS=5
DIRECTORY_REFRESH_SECONDS=300
DIRECTORY_MAX_AGE_HOURS=24
OVERDUE_CHECK_SECONDS=60
# Feriados del campus para días hábiles (E2-AS-02), ISO separados por coma
CAMPUS_HOLIDAYS=
